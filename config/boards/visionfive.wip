# RISC-V StarFive
BOARD_NAME="VisionFive"
BOARDFAMILY="starfive"
KERNEL_TARGET="edge"
BOOT_FDT_FILE="starfive/jh7100-starfive-visionfive-v1.dtb"
ALLOW_EXTLINUX="yes"
SRC_EXTLINUX="yes"
SRC_CMDLINE="console=ttyS0,115200n8 console=tty0 earlycon=sbi rootflags=data=writeback"
BOOTCONFIG=none
PACKAGE_LIST_BOARD_REMOVE="hostapd"
