# Rockchip RK3399 hexa core 2GB SoC GBe eMMC USB3 WiFi/BT
BOARD_NAME="Tinker Board 2"
BOARDFAMILY="rockchip64"

BOOTCONFIG="tinker-2-rk3399_defconfig" # EVB defconfig/dts (evb-rk3399_defconfig) uboot also works on TB2, but kernel then spits garbage after initting i2c.

KERNEL_TARGET="classic,current,edge"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3399-tinker-2.dtb"

# Using ASUS own 856MHZ DDR blobs.
RKBIN_GIT_URL="https://github.com/rpardini/armbian-rkbin" # With ASUS's blobs
BOOT_SCENARIO="tpl-blob-atf-mainline"
DDR_BLOB="rk33/rk3399_ddr_800MHz_v1.26_ASUS_TB2.bin"

SERIALCON="ttyS2"
BOARD_FIRMWARE_INSTALL="-full" # Install full firmware, for rtl8822ce firmware and others

# Extra debugging stuff in uboot, enable with UBOOT_DEBUGGING=yes
# UBOOT_DEBUGGING="yes"

# Lemme enable extlinux super-quick..
#SRC_EXTLINUX="yes"   # Use extlinux, I don't wanna be writing bootscript for this
#ALLOW_EXTLINUX="yes" # Allow extlinux.

UBOOT_SCHEME="full-vendor-stuff"
UBOOT_SCHEME="semi-vendor-stuff"

display_alert "Activating UBOOT_SCHEME for TB2" "${UBOOT_SCHEME}" "warn"
case ${UBOOT_SCHEME} in

	"semi-vendor-stuff")
		BOOT_SCENARIO="only-blobs"
		BOOTCONFIG="tinker_board_2_defconfig"
		BOOT_SOC="rk3399"
		# Hacks after the family/arm64 code has run, to override...
		function post_family_config__use_vendor_uboot() {
			display_alert "Using vendor uboot" "post_family_config__use_vendor_uboot" "warn"
			BOOTSOURCE='https://github.com/rpardini/u-boot-tb2-asus.git'
			BOOTBRANCH='branch:modern'
			BOOTDIR='u-boot-asus-tb2'
			BOOTPATCHDIR="u-boot-asus-tb2" # Does not exist, no further patches.
			ATFSOURCE=''                   # This is 'only-blobs', don't build ATF.
			ATF_COMPILE='no'
		}

		function fetch_custom_uboot__tb2_vendor() {
			display_alert "Fetching custom u-boot" "fetch_custom_uboot__tb2_vendor BOOTDIR: '${BOOTDIR}'" "warn"
			# Fetch the vendor rkbins expected by the vendor u-boot in the ../rkbin
			fetch_from_repo "https://github.com/TinkerBoard2/rkbin.git" "${BOOTDIR}/rkbin" "branch:linux4.19-rk3399-debian10"
		}

		function build_custom_uboot__tb2_vendor() {
			display_alert "Preparing custom u-boot" "build_custom_uboot__tb2_vendor: $(pwd)" "warn"

			# Build the vendor uboot using their own scripts / Makefiles.
			run_host_command_logged git clean -xfd
			run_host_command_logged ./make.sh tinker2 # loader --spl --tpl

			# What the hell is the `rk3399_loader_v1.26.126.bin` produced by make.sh?
			display_alert "Creating idbloader.bin for $BOOT_SOC" "tb2; DDR_BLOB=${FULL_DDR_BLOB}" "warn"
			FULL_DDR_BLOB="${SRC}/cache/sources/u-boot-asus-tb2/rkbin/bin/rk33/rk3399_ddr_800MHz_v1.26.bin" # or, for 115200, rk3399_ddr_800MHz_v1.26_115200.bin
			[[ -f idbloader.bin ]] && rm -f idbloader.bin
			run_host_command_logged tools/mkimage -n "${BOOT_SOC}" -T rksd -d "${FULL_DDR_BLOB}" idbloader.bin

			FULL_MINILOADER_BLOB="${SRC}/cache/sources/u-boot-asus-tb2/rkbin/bin/rk33/rk3399_miniloader_v1.26.bin"
			# FULL_MINILOADER_BLOB="rk3399_loader_v1.26.126.bin" # does NOT WORK either.
			display_alert "Adding miniloader to idbloader.bin" "tb2; FULL_MINILOADER_BLOB=${FULL_MINILOADER_BLOB}" "warn"
			run_host_command_logged cat "${FULL_MINILOADER_BLOB}" ">>" idbloader.bin # escaped redirect, so all happens inside runner and logs correctly

			run_host_command_logged cp -pv trust.img trust.bin # THIS WORKS!? how? it shouldn't

			display_alert "Creating uboot.img from uboot-dtb.bin" "only-blobs" "debug"
			run_host_command_logged rm -fv uboot.img
			run_host_x86_binary_logged $RKBIN_DIR/tools/loaderimage --pack --uboot ./u-boot-dtb.bin uboot.img 0x00200000 --size 2048 2

			# Deploy the built bins to the target (where .deb will be built -- akin to what UBOOT_TARGET_MAP does, but without make'ing anything)
			loop_over_uboot_targets_and_do deploy_built_uboot_bins_for_one_target_to_packaging_area

			export EXTENSION_BUILT_UBOOT="yes" # Armbian will NOT build or handle bin assets. Everything is already done above.
		}

		;;

	"full-vendor-stuff")
		BOOT_SCENARIO="only-blobs"

		# Hacks after the family/arm64 code has run, to override...
		function post_family_config__use_vendor_uboot() {
			display_alert "Using vendor uboot" "post_family_config__use_vendor_uboot" "warn"
			BOOTSOURCE='https://github.com/rpardini/u-boot-tb2-asus.git'
			BOOTBRANCH='branch:modern-4.19'
			BOOTDIR='u-boot-asus-tb2'
			BOOTPATCHDIR="u-boot-asus-tb2" # Does not exist, no further patches.
			ATFSOURCE=''                   # This is 'only-blobs', don't build ATF.
			ATF_COMPILE='no'
		}

		function fetch_custom_uboot__tb2_vendor() {
			display_alert "Fetching custom u-boot" "fetch_custom_uboot__tb2_vendor BOOTDIR: '${BOOTDIR}'" "warn"
			# Fetch the vendor rkbins expected by the vendor u-boot in the ../rkbin
			fetch_from_repo "https://github.com/TinkerBoard2/rkbin.git" "${BOOTDIR}/rkbin" "branch:linux4.19-rk3399-debian10"
		}

		function build_custom_uboot__tb2_vendor() {
			display_alert "Preparing custom u-boot" "build_custom_uboot__tb2_vendor: $(pwd)" "warn"

			# Build the vendor uboot using their own scripts / Makefiles.
			run_host_command_logged git clean -xfd
			run_host_command_logged ./make.sh tinker_board_2 # loader --spl --tpl

			# What the hell is the `rk3399_loader_v1.26.126.bin idbloader.bin` produced by make.sh?
			#run_host_command_logged cp -pv rk3399_loader_v1.26.126.bin idbloader.bin

			## display_alert "Creating idbloader.bin for $BOOT_SOC" "tb2; DDR_BLOB=${FULL_DDR_BLOB}" "warn"
			## FULL_DDR_BLOB="${SRC}/cache/sources/u-boot-asus-tb2/rkbin/bin/rk33/rk3399_ddr_800MHz_v1.26_115200.bin"
			## [[ -f idbloader.bin ]] && rm -f idbloader.bin
			## run_host_command_logged tools/mkimage -n "${BOOT_SOC}" -T rksd -d "${FULL_DDR_BLOB}" idbloader.bin
			##
			## FULL_MINILOADER_BLOB="${SRC}/cache/sources/u-boot-asus-tb2/rkbin/bin/rk33/rk3399_miniloader_v1.26.bin"
			## display_alert "Adding miniloader to idbloader.bin" "tb2; FULL_MINILOADER_BLOB=${FULL_MINILOADER_BLOB}" "warn"
			## run_host_command_logged cat "${FULL_MINILOADER_BLOB}" >> idbloader.bin
			##
			## # What about 'trust.bin' ? is it the same as trust.img? @TODO apparently not...
			## run_host_command_logged cp -pv trust.img trust.bin

			# Give up and use LibreELEC stuff to make sure
			run_host_command_logged cp -v /opt/build_libreelec/libreelec-master-rpardini/build.LibreELEC-RK3399.arm-11.0-devel/image/system/usr/share/bootloader/idbloader.img idbloader.bin
			run_host_command_logged cp -v /opt/build_libreelec/libreelec-master-rpardini/build.LibreELEC-RK3399.arm-11.0-devel/image/system/usr/share/bootloader/trust.img trust.bin
			#run_host_command_logged cp -v /opt/build_libreelec/libreelec-master-rpardini/build.LibreELEC-RK3399.arm-11.0-devel/image/system/usr/share/bootloader/uboot.img uboot.img

			# Deploy the built bins to the target (where .deb will be built -- akin to what UBOOT_TARGET_MAP does, but without make'ing anything)
			loop_over_uboot_targets_and_do deploy_built_uboot_bins_for_one_target_to_packaging_area

			export EXTENSION_BUILT_UBOOT="yes" # Armbian will NOT build or handle bin assets. Everything is already done above.
		}

		;;

	*)
		display_alert "Default board uboot stuff" "BOOT_SCENARIO: ${BOOT_SCENARIO}" warn
		;;

esac
