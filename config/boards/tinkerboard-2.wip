# Rockchip RK3399 hexa core 2GB SoC GBe eMMC USB3 WiFi/BT
BOARD_NAME="Tinker Board 2"
BOARDFAMILY="rockchip64"
BOOTCONFIG="tinker2_defconfig"
KERNEL_TARGET="classic,current,edge"
FULL_DESKTOP="yes"
BOOT_LOGO="desktop"
BOOT_FDT_FILE="rockchip/rk3399-tinker-2.dtb"
BOOT_SOC="rk3399" # This determined BOOT_SCENARIO et al.
BOOT_SCENARIO="spl-blobs"
SERIALCON="ttyS2"
BOARD_FIRMWARE_INSTALL="-full" # Install full firmware, for rtl8822ce firmware and others

DDR_BLOB="rk35/rk3568_ddr_1560MHz_v1.10.bin-NOTEXISTS" # Real blob, is actually used. in rkbin repository. HK uses 1.09, 1.10 seems to work just as well.
BL31_BLOB="rk35/rk356x_usbplug_v1.10.bin--FAKE"        # Not really used for anything, as the name proves.

function post_family_config__tb2_vendor_kernel() {
	:
	case $BRANCH in

		legacy)
			display_alert "Applying legacy kernel config" "tinkerboard-2" "warn"

			BOOTSOURCE='https://github.com/TinkerBoard2/u-boot.git'
			BOOTBRANCH='branch:linux4.4-rk3399-debian10'
			BOOTPATCHDIR="u-boot-tb2-vendor"
			BOOTCONFIG="tinker2_defconfig"

			KERNELDIR='linux-tb2-vendor'
			KERNELSOURCE='https://github.com/TinkerBoard2/kernel.git'
			#export KERNEL_MAJOR_MINOR="4.19" # Major and minor versions of this kernel.
			#KERNELBRANCH='branch:linux4.19-rk3399-debian10'
			export KERNEL_MAJOR_MINOR="4.4" # Major and minor versions of this kernel.
			KERNELBRANCH='branch:linux4.4-rk3399-debian10'
			KERNELPATCHDIR='rockchip64-tb2o-'$BRANCH
			LINUXFAMILY="rockchip64-tb2o-vendor"
			LINUXCONFIG="rockchip64-tb2o-vendor-legacy"
			BOOT_FDT_FILE="rockchip/rk3399-tinker_board_2.dtb"
			SRC_EXTLINUX="yes"                                                                     # Use extlinux, I don't wanna be writing bootscript for this
			ALLOW_EXTLINUX="yes"                                                                   # Allow extlinux.
			SRC_CMDLINE="earlycon=uart8250,mmio32,0xff1a0000 swiotlb=1 console=ttyFIQ0 loglevel=7" # Console on uart and HDMI, very high verbosity on uart
			;;

	esac

}

# @TODO: rpardini. lazy hack. call RK's make.sh. That uses its own rkbins.
function build_custom_uboot__tb2() {
	export EXTENSION_BUILT_UBOOT="no, but is prepared" # Armbian still will build after this
	display_alert "Preparing custom u-boot" "TB2" "warn"

	# Patch first though, for fixes
	advanced_patch "u-boot" "$BOOTPATCHDIR" "$BOARD" "" "$BRANCH" "${LINUXFAMILY}-${BOARD}-${BRANCH}"

	git status || true

	# install pyelftools
	#curl https://bootstrap.pypa.io/pip/2.7/get-pip.py --output get-pip.py
	#python2 get-pip.py
	#python2 -m pip install pyelftools

	# @TODO: those use rkbin tools which are x86-only; they're pulled via git submodule.
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh tinker2
	#KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh --spl
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh uboot
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh loader
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh trust
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh --idblock
	KCFLAGS="-fdiagnostics-color=always -Wno-error=address-of-packed-member -Wno-error=maybe-uninitialized" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh itb # requires python2 pyelftools

	#display_alert "Showing make.sh help"
	#KCFLAGS="-fdiagnostics-color=always -Wno-error=maybe-uninitialized -Wno-error=misleading-indentation" PATH="/usr/bin/:${PATH}" run_host_command_logged ./make.sh --help || true

	run_host_command_logged ls -laht || true

	function uboot_custom_postprocess() {
		run_host_command_logged pwd
		run_host_command_logged ls -laht || true
		#run_host_command_logged cp -pv trust.img trust.bin
		#run_host_command_logged cp -pv idblock.bin idbloader.bin

		display_alert "mkimage for $BOOT_SOC with $BOOT_SCENARIO" "spl-blobs" "debug"
		run_host_command_logged tools/mkimage -n $BOOT_SOC -T rksd -d /opt/build_armbian/extensions/cache/sources/u-boot/rkbin/bin/rk33/rk3399_ddr_800MHz_v1.26_115200.bin:spl/u-boot-spl.bin idbloader.img


	}

}

declare -g UBOOT_GIT_SKIP_SUBMODULES="yes" # skip fetching submodules during uboot fetch
function fetch_custom_uboot__tb2_vendor() {
	display_alert "Fetching custom u-boot" "TB2: UBOOT_GIT_SKIP_SUBMODULES: '${UBOOT_GIT_SKIP_SUBMODULES}' BOOTDIR: '${BOOTDIR}'" "debug"
	# Vendor source has bizarre submodule reference to it's own rkbins. Avoid with UBOOT_GIT_SKIP_SUBMODULES and fetch it ourselves.
	fetch_from_repo "https://github.com/TinkerBoard2/rkbin.git" "${BOOTDIR}/linux4.4-rk3399-debian10/../rkbin" "branch:linux4.19-rk3399-debian10"
}
