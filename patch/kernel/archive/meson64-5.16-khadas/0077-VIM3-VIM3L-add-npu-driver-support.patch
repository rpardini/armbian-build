new file mode 100644
index 000000000000..2cf543110743
--- /dev/null
+++ b/drivers/staging/npu/os/linux/kernel/platform/amlogic/gc_hal_kernel_platform_pico.c
@@ -0,0 +1,453 @@
+/****************************************************************************
+*
+*    Copyright (c) 2005 - 2020 by Vivante Corp.  All rights reserved.
+*
