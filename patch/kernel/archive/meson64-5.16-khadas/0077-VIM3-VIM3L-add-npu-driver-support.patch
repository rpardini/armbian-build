+static gceSTATUS
+_GetMapIndex(
+    gctUINT8 DataType,
+    gctUINT32_PTR Index
+    )
+{
+    gceSTATUS status = gcvSTATUS_OK;
+
+    if (!Index)
+    {
+        gcmkONERROR(gcvSTATUS_INVALID_ARGUMENT);
+    }
+
+    switch (DataType)
+    {
+    case 0x1:
+        *Index = 1;
+        break;
+
+    case 0x7:
