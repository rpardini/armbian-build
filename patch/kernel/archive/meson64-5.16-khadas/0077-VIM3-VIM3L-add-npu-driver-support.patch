+/*============the control format should as: (control-domain:control-value)==========*/
+static int kcmp(const char *buff,const char *token,int lenth)
+{
+	int i = 0;
+	int flag = 0;
+	for(i=0;i<lenth;i++)
+	{
+		if(buff[i] != token[i])
+		{
+			flag = 1;
+			break;
+		}
+	}
+	return flag;
+}
+static int findtok(const char *buff,const char token,int lenth)
+{
+	int pos = 0;
+	int i = 0;
+	for(i=0;i<lenth;i++)
+	{
+		if(buff[i] == token)
+		{
+			pos = i;
+			break;
+		}
+	}
+	return pos;
+}
