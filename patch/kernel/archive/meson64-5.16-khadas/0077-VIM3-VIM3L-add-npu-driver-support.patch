+	gcmkONERROR(gckDEBUGFS_DIR_Init(dir, gcvNULL, "galcore"));
+    gcmkONERROR(gckDEBUGFS_DIR_CreateFiles(dir, InfoList, gcmCOUNTOF(InfoList), Device));
