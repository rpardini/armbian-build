+    gckOS_ZeroMemory(preemptCommit, sizeof(gcsPREEMPT_COMMIT));
+
+    preemptCommit->priorityID = PriorityID;
+
+    preemptCommit->isNop = gcvTRUE;
+
+    *PreemptCommit = preemptCommit;
+
+OnError:
+    gcmkFOOTER();
+    return status;
+}
