+    VSC_OCLImgLibKind *     pImgLibKind, /* the image lib kind to be used */
+    gctBOOL *               UseTexld                /* set true if need to use texld for image_read */
+    );
+
+gceSTATUS
+vscConstructImageWriteLibFuncName(
+    VSC_ImageDesc *         ImageDescHandle, /* VSC_ImageDesc */
