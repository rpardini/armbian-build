+   this SHADER_IO_CHANNEL_MAPPING. When it is disabled, any hwRegChannel can be allocated to
+   this SHADER_IO_CHANNEL_MAPPING */
+#define IO_HW_CHANNEL_IDENTICAL_TO_IO_LL_CHANNEL 1
