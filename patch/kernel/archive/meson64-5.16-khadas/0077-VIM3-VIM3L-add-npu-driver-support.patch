+    gctUINT32                   sRAMSizes[gcvSRAM_INTER_COUNT];
+
+    gctUINT64                   platformFlagBits;
+
+    /* APB register offset. */
+    gctUINT64                   registerAPB;
+
+    /* Enabled NN clusters number. */
+    gctUINT32                   nnClusterNum;
+}
+gcsHAL_QUERY_CHIP_IDENTITY;
