+**
+**      gctBOOL Clock
+**          gcvTRUE to turn on the clock, or gcvFALSE to turn off the clock.
+**
+**  OUTPUT:
+**
+**      Nothing.
+*/
+gceSTATUS
+gckOS_GetClockState(
+    IN gckOS Os,
+    IN gceCORE Core,
+    IN gctBOOL * Clock
+    )
+{
+    *Clock = Os->clockStates[Core];
+
+    return gcvSTATUS_OK;
+}
