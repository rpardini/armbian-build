+    gctUINT                                     baseAddressIndexInPrivConstTable;
+    SHADER_DEFAULT_UBO_MEMBER_ENTRY*            pDefaultUboMemberEntries;
+    gctUINT                                     countOfEntries;
+    gctUINT                                     sizeInByte;
+}SHADER_DEFAULT_UBO_MAPPING;
+
+END_EXTERN_C();
+
+#endif /* __gc_vsc_drvi_shader_priv_mapping_h_ */
+
