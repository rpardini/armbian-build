+                else if(i == 1)
+                {
+                    gcmkPRINT("TP workaround verify failed!");
+                    return status;
+                }
+            }
+        }
+        if(i == 0)
+        {
+            gcmkPRINT("top 2 outputBytes: %c, %c",((char*)(Execution->funcCmd[i].outlogical))[0], ((char*)(Execution->funcCmd[i].outlogical))[1]);
