+typedef struct _VSC_RECOMPILER_CONFIG
+{
+    VSC_CONTEXT                       ctx;
+
+    /* Recompiler controls */
+    gctUINT                           rcFlags;
+}VSC_RECOMPILER_CONFIG, *PVSC_RECOMPILER_CONFIG;
+
