+static gceSTATUS
+_GetNNDataSize(
+   IN gctUINT8 DataType,
+   OUT gctUINT32_PTR DataSize
+   )
+{
+    gceSTATUS status = gcvSTATUS_OK;
+
+    if (!DataSize)
+    {
+        gcmkONERROR(gcvSTATUS_INVALID_ARGUMENT);
