+    gctUINT32                   extSRAMSizes[gcvSRAM_EXT_COUNT];
+    gctUINT32                   extSRAMCount;
+
+    gceSECURE_MODE              secureMode;
+
+    gctBOOL                     hasShader;
+
+    /* NN clusters power control. */
+    gctUINT32                   enableNNClusters;
+    gctUINT32                   configNNPowerControl;
+}
