+    gcSL_SWIZZLE_XZZW = gcmSWIZZLE(X, Z, Z, W),
+    gcSL_SWIZZLE_YYZW = gcmSWIZZLE(Y, Y, Z, W),
+    gcSL_SWIZZLE_XXXY = gcmSWIZZLE(X, X, X, Y),
+    gcSL_SWIZZLE_XZXZ = gcmSWIZZLE(X, Z, X, Z),
