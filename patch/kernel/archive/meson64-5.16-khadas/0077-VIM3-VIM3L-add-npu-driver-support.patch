+            command->data = gcvNULL;
+            command->dataCount = 0;
+        }
+
+        /* Free command. */
+        if (command->funcVidMem)
+        {
+            if (command->address)
+            {
+                /* Synchroneous unlock. */
+                gcmkVERIFY_OK(gckVIDMEM_NODE_Unlock(
+                    hardware->kernel,
