Subject: [PATCH 09/29] arm64: dts: amlogic: meson-g12-common: add uart_AO_B
 pinctrl

Signed-off-by: Stephen <stephen@vamrs.com>
---
 .../boot/dts/amlogic/meson-g12-common.dtsi    | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
index 075153a4d49f..1fe85d69eb25 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
@@ -1936,6 +1936,33 @@ mux {
 						};
 					};
 
+					uart_ao_b_tx_2_rx_3_pins: uart-ao-b-tx-2-rx-3 {
+						mux {
+							groups = "uart_ao_b_tx_2",
+								"uart_ao_b_rx_3";
+							function = "uart_ao_b";
+							bias-disable;
+						};
+					};
+
+					uart_ao_b_tx_8_rx_9_pins: uart-ao-b-tx-8-rx-9 {
+						mux {
+							groups = "uart_ao_b_tx_8",
+								"uart_ao_b_rx_9";
+							function = "uart_ao_b";
+							bias-disable;
+						};
+					};
+
+					uart_ao_b_cts_rts_pins: uart-ao-b-cts-rts {
+						mux {
+							groups = "uart_ao_b_cts",
+								"uart_ao_b_rts";
+							function = "uart_ao_b";
+							bias-disable;
+						};
+					};
+
 					pwm_a_e_pins: pwm-a-e {
 						mux {
 							groups = "pwm_a_e";
