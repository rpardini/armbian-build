From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Thu, 10 Aug 2023 12:28:27 +0200
Subject: kvim4: enable UMS, reduce bootdelay

also add armbian localversion
---
 board/khadas/defconfigs/kvim4_defconfig | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/board/khadas/defconfigs/kvim4_defconfig b/board/khadas/defconfigs/kvim4_defconfig
index 4f6a4aad8ca..467ccba4a9c 100644
--- a/board/khadas/defconfigs/kvim4_defconfig
+++ b/board/khadas/defconfigs/kvim4_defconfig
@@ -11,9 +11,11 @@ CONFIG_BL30_SELECT="kvim4"
 CONFIG_DEBUG_UART_BASE=0xfe078000
 CONFIG_DEBUG_UART_CLOCK=24000000
 CONFIG_DEBUG_UART=y
+CONFIG_LOCALVERSION="-armbian"
+# CONFIG_LOCALVERSION_AUTO is not set
 # CONFIG_ANDROID_BOOT_IMAGE is not set
 CONFIG_OF_BOARD_SETUP=y
-CONFIG_BOOTDELAY=2
+CONFIG_BOOTDELAY=1
 CONFIG_BOARD_LATE_INIT=y
 # CONFIG_DISPLAY_CPUINFO is not set
 # CONFIG_DISPLAY_BOARDINFO is not set
@@ -37,6 +39,7 @@ CONFIG_AML_STORAGE=y
 CONFIG_CMD_SF=y
 CONFIG_CMD_SF_TEST=y
 CONFIG_CMD_USB=y
+CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_SARADC=y
 # CONFIG_CMD_SETEXPR is not set
 CONFIG_CMD_BMP=y
-- 
Armbian

